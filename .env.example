# Backend only. Never prefix secrets with VITE_.
# Setup instructions: docs/credentials.md
APP_ENV=development
MONGODB_URI=
MONGODB_DATABASE=ip_sakti
GEMINI_API_KEY=
# Set to models enabled for your Google API project.
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
APP_ORIGIN=http://127.0.0.1:5173
# Clerk backend credentials. Keep the secret key server-side.
CLERK_SECRET_KEY=
# Optional PEM public key for networkless JWT verification. Literal \n is accepted.
CLERK_JWT_KEY=
DATA_DIR=data
# Optional Bhashini integration. Configure approved inference endpoint and service IDs.
BHASHINI_URL=
BHASHINI_API_KEY=
BHASHINI_ASR_SERVICE=
BHASHINI_TTS_SERVICE=
BHASHINI_TRANSLATION_SERVICE=

# Optional tracing and evaluation; content is redacted by default.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ip-sakti-development
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_CAPTURE_CONTENT=false
RAGAS_JUDGE_MODEL=gemini-2.5-flash
RETRIEVAL_CANDIDATES=25
RETRIEVAL_SHORTLIST=20
RETRIEVAL_FINAL_K=8
RETRIEVAL_CONTEXT_CHARS=24000
